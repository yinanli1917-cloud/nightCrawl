{
  "manifest_version": 3,
  "name": "nightCrawl Bridge",
  "version": "0.1.0",
  "description": "Lets your local nightCrawl daemon drive THIS real browser as Engine R \u2014 your real fingerprint and live sessions, used in the background.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "nightCrawl Bridge"
  },
  "key": ""
}
